<?xml version="1.0" encoding="UTF-8"?>
<!-- YT7th CEP panel for Adobe Premiere Pro.
     Node.js is enabled so the panel can find/launch the engine daemon and
     speak HTTP to it; ExtendScript (host/index.jsx) does the actual import. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.seventh.yt7th.premiere"
    ExtensionBundleVersion="1.0.0" ExtensionBundleName="YT7th"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.seventh.yt7th.premiere.panel" Version="1.0.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="8.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.seventh.yt7th.premiere.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/index.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>YT7th</Menu>
          <Geometry>
            <Size><Height>360</Height><Width>320</Width></Size>
            <MinSize><Height>300</Height><Width>260</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
